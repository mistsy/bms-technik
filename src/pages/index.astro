---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import ContactBanner from '../components/ContactBanner.astro';
import { airConditioning, ventilation } from '../data/site';

const highlights = [
  { ...ventilation[0], category: 'Wentylacja mechaniczna' },
  { ...ventilation[4], category: 'Rekuperacja i wentylacja' },
  { ...airConditioning[1], category: 'Klimatyzacja domu' },
  { ...airConditioning[2], category: 'Klimatyzacja biura' },
];
---
<Layout path="/" hasGallery description="BMS Technik: rekuperacja, wentylacja, klimatyzacja i serwis. Zobacz zdjęcia realizacji oraz skontaktuj się z nami w Skale lub Krakowie.">
  <section class="home-choice blueprint" aria-labelledby="home-title">
    <div class="shell choice-inner">
      <h1 id="home-title">Rekuperacja, wentylacja i klimatyzacja</h1>
      <nav class="service-choice" aria-label="Wybierz dziedzinę naszej oferty">
        <a class="service-choice-link" href="/rekuperacja/">
          <h2>Rekuperacja /<br /> Wentylacja</h2>
          <p>Wentylacja z odzyskiem ciepła.<br />Od projektu po montaż i regulację.</p>
          <span class="choice-action">Poznaj ofertę <Icon name="arrow" /></span>
        </a>
        <a class="service-choice-link" href="/klimatyzacja/">
          <h2>Klimatyzacja</h2>
          <p>Komfort w domu i biurze.<br />Dobór, montaż i opieka serwisowa.</p>
          <span class="choice-action">Poznaj ofertę <Icon name="arrow" /></span>
        </a>
      </nav>
      <p class="choice-location">BMS Technik · Skała · Kraków</p>
    </div>
  </section>

  <section class="section shell" id="realizacje" aria-labelledby="realizacje-title">
    <div class="section-header">
      <div><p class="eyebrow">Zdjęcia z instalacji</p><h2 id="realizacje-title">Nasze realizacje</h2></div>
      <p>Projektujemy i montujemy wentylację z odzyskiem ciepła. Dobieramy, montujemy i serwisujemy klimatyzację. Zobacz przykłady naszych realizacji w domach i biurach.</p>
    </div>
    <Gallery label="Wybrane zdjęcia realizacji BMS Technik" photos={highlights} featured />
  </section>

  <ContactBanner text="Opowiedz nam, czego potrzebujesz. Pomożemy określić zakres prac i przygotować ofertę." />
</Layout>
