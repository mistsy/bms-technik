---
import Icon from './Icon.astro';
import { logo, navigation, phone } from '../data/site';
const { path } = Astro.props;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <img src={logo} width="168" height="102" alt="BMS Technik – strona główna" />
    </a>
    <nav class="desktop-nav" aria-label="Menu główne">
      <ul>{navigation.map(({ label, href }) => <li><a href={href} aria-current={href === path ? 'page' : undefined}>{label}</a></li>)}</ul>
    </nav>
    <a class="header-phone" href={phone.href}><Icon name="phone" /> {phone.text}</a>
    <details class="mobile-menu">
      <summary aria-controls="mobile-navigation" aria-label="Menu główne">
        <span class="menu-label">Menu</span>
        <span class="menu-glyph" aria-hidden="true"><span></span><span></span><span></span></span>
      </summary>
      <nav id="mobile-navigation" aria-label="Menu główne">
        <ul>{navigation.map(({ label, href }) => <li><a href={href} aria-current={href === path ? 'page' : undefined}>{label}</a></li>)}</ul>
        <a href={phone.href}><Icon name="phone" /> {phone.text}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  import { motionOptions, reducedMotion } from '../scripts/motion';

  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu')!;
  const toggle = menu.querySelector('summary')!;
  const panel = menu.querySelector('nav')!;
  const mobile = window.matchMedia('(max-width: 53rem)');
  let expanded = menu.open;
  let animation: Animation | undefined;

  function updateState() {
    toggle.setAttribute('aria-expanded', String(expanded));
    toggle.setAttribute('aria-label', expanded ? 'Zamknij menu' : 'Otwórz menu');
    menu.dataset.expanded = String(expanded);
    panel.inert = !expanded;
  }

  function cancel() {
    if (animation) animation.onfinish = null;
    animation?.cancel();
    animation = undefined;
  }

  function settle() {
    menu.open = expanded;
    cancel();
  }

  function setExpanded(next: boolean, instant = false) {
    if (next === expanded && !instant) return;
    expanded = next;
    if (!expanded && panel.contains(document.activeElement)) toggle.focus({ preventScroll: true });
    updateState();
    const style = getComputedStyle(panel);
    const opacity = menu.open ? style.opacity : '0';
    const transform = menu.open ? style.transform : 'translateY(-8px)';
    cancel();
    const options = motionOptions();
    if (instant || !options.duration) {
      settle();
      return;
    }
    menu.open = true;
    const current = animation = panel.animate({
      opacity: [opacity, expanded ? '1' : '0'],
      transform: [transform, expanded ? 'translateY(0)' : 'translateY(-8px)'],
    }, options);
    current.onfinish = () => {
      if (animation === current) settle();
    };
  }

  toggle.addEventListener('click', (event) => {
    event.preventDefault();
    setExpanded(!expanded);
  });
  menu.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && expanded) {
      event.preventDefault();
      setExpanded(false);
      toggle.focus({ preventScroll: true });
    }
  });
  menu.addEventListener('focusout', (event) => {
    // WebKit can flush microtasks between blur and focus, when activeElement
    // is still body. Use the destination to avoid closing between menu links.
    if (!(event.relatedTarget instanceof Node) || !menu.contains(event.relatedTarget)) setExpanded(false);
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !menu.contains(event.target)) setExpanded(false);
  });
  mobile.addEventListener('change', () => {
    if (!mobile.matches) setExpanded(false, true);
  });
  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) settle();
  });
  // Let link activation finish before resetting: making its panel inert inside
  // the click handler cancels anchor activation in WebKit.
  // Reset before a page enters the back/forward cache as well as on restoration.
  window.addEventListener('pagehide', () => setExpanded(false, true));
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) setExpanded(false, true);
  });
  updateState();
</script>
