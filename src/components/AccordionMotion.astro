<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const motion = getComputedStyle(document.documentElement);
  const durationValue = motion.getPropertyValue('--motion-duration').trim();
  // The production CSS optimizer may serialize 240ms as .24s.
  const duration = parseFloat(durationValue) * (durationValue.endsWith('ms') ? 1 : 1000);
  const easing = motion.getPropertyValue('--motion-easing').trim();

  document.querySelectorAll<HTMLElement>('.accordion').forEach((accordion, groupIndex) => {
    const items = [...accordion.querySelectorAll<HTMLDetailsElement>('details')];
    const controllers = items.map((details, index) => {
      const summary = details.querySelector('summary')!;
      const content = details.querySelector<HTMLElement>('.accordion-content')!;
      const group = details.name;
      let expanded = details.open;
      let heightAnimation: Animation | undefined;
      let contentAnimation: Animation | undefined;
      // Native grouping is the no-JS fallback; enhanced peers close after animating.
      details.removeAttribute('name');
      summary.id = `accordion-trigger-${groupIndex}-${index}`;
      content.id = `accordion-panel-${groupIndex}-${index}`;
      summary.setAttribute('aria-controls', content.id);
      content.setAttribute('role', 'region');
      content.setAttribute('aria-labelledby', summary.id);

      function updateState() {
        summary.setAttribute('aria-expanded', String(expanded));
        details.dataset.expanded = String(expanded);
        content.inert = !expanded;
      }

      function settle() {
        heightAnimation?.cancel();
        contentAnimation?.cancel();
        heightAnimation = contentAnimation = undefined;
        details.open = expanded;
        details.style.removeProperty('overflow');
      }

      function setExpanded(next: boolean) {
        if (next === expanded) return;
        const startHeight = details.getBoundingClientRect().height;
        heightAnimation?.cancel();
        contentAnimation?.cancel();
        expanded = next;
        if (!expanded && content.contains(document.activeElement)) summary.focus();
        updateState();
        if (reducedMotion.matches) {
          settle();
          return;
        }

        details.open = true;
        const endHeight = expanded
          ? details.getBoundingClientRect().height
          : summary.getBoundingClientRect().height + parseFloat(getComputedStyle(details).borderBottomWidth);
        details.style.overflow = 'hidden';
        heightAnimation = details.animate(
          { height: [`${startHeight}px`, `${endHeight}px`] },
          { duration, easing },
        );
        contentAnimation = content.animate(
          { opacity: expanded ? [0, 1] : [1, 0], transform: expanded ? ['translateY(-4px)', 'translateY(0)'] : ['translateY(0)', 'translateY(-4px)'] },
          { duration, easing },
        );
        heightAnimation.onfinish = settle;
      }

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        if (!expanded && group) {
          controllers.forEach((peer) => {
            if (peer.group === group && peer.details !== details) peer.setExpanded(false);
          });
        }
        setExpanded(!expanded);
      });
      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches) settle();
      });
      updateState();
      return { details, group, setExpanded };
    });
  });
</script>
