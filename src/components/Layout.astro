---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Lightbox from './Lightbox.astro';
import AccordionMotion from './AccordionMotion.astro';
import { business, media } from '../data/site';
import '../styles/site.css';
import mondaLatin from '../../generated/public/fonts/monda-latin.woff2?url';
import mondaPolish from '../fonts/monda-polish.woff2?url';
import shareTech from '../../generated/public/fonts/share-tech.woff2?url';

interface Props {
  path?: keyof typeof business;
  description: string;
  title?: string;
  hasGallery?: boolean;
}
const { path, description, title, hasGallery = false } = Astro.props;
const page = path ? business[path] : undefined;
---
<!doctype html>
<html lang="pl-PL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- All three faces occur above the fold, including Monda's Polish glyphs
         inside Share Tech headings. Match font fetches' anonymous CORS mode. -->
    <link rel="preload" href={mondaLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={mondaPolish} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={shareTech} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{page?.title ?? title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={page ? 'max-image-preview:large' : 'noindex'} />
    {page && <link rel="canonical" href={page.canonical} />}
    <link rel="icon" href={media + '2022/03/fav.svg'} type="image/svg+xml" />
    <link rel="icon" href={media + '2022/03/cropped-maintenance-32x32.png'} sizes="32x32" />
    <link rel="icon" href={media + '2022/03/cropped-maintenance-192x192.png'} sizes="192x192" />
    <link rel="apple-touch-icon" href={media + '2022/03/cropped-maintenance-180x180.png'} />
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <Header path={path} />
    <main id="tresc" tabindex="-1"><slot /></main>
    <Footer />
    {hasGallery && <Lightbox />}
    <AccordionMotion />
  </body>
</html>
